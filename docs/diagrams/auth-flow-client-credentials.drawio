<mxfile host="app.diagrams.net" type="device">
  <diagram id="client-credentials" name="Client Credentials (M2M)">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h_sa" value="Service / Machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_auth" value="auth-server (SAS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="20" width="140" height="40" as="geometry" /></mxCell>

        <mxCell id="ll_sa" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="60" as="sourcePoint" /><mxPoint x="150" y="360" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll_auth" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="60" as="sourcePoint" /><mxPoint x="510" y="360" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m1" value="1. /oauth2/token (grant_type=client_credentials,&#10;client_id + secret or API key)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="110" as="sourcePoint" /><mxPoint x="510" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. resolve service-account roles / permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="170" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="m3" value="3. access token (JWT)" style="html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="260" as="sourcePoint" /><mxPoint x="150" y="260" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
