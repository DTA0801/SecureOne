<mxfile host="app.diagrams.net" type="device">
  <diagram id="enterprise-capability-map" name="Enterprise Capability Map">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="core" value="SecureOne&#10;Enterprise IAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="200" height="60" as="geometry" /></mxCell>

        <mxCell id="d1" value="1. Federation &amp; Brokering&#10;External IdPs, LDAP/AD, home-realm discovery, account linking / JIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d2" value="2. Adaptive Authentication&#10;Configurable flows, risk-based / step-up, passwordless / passkeys, leaked-password &amp; bot detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="140" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d3" value="3. Fine-grained AuthZ&#10;RBAC / ABAC / ReBAC, policy-as-code (OPA / Cedar), UMA 2.0, resource servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d4" value="4. Governance (IGA)&#10;Joiner-Mover-Leaver, access requests &amp; approvals, certification campaigns, Segregation of Duties" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d5" value="5. Orgs &amp; Delegated Admin&#10;Organizations / sub-orgs, nested groups, delegated administration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d6" value="6. Self-Service &amp; UX&#10;Account portal, per-tenant branding / i18n, consent &amp; connected apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d7" value="7. Protocol Hardening&#10;Token Exchange / PAR / DPoP, CIBA / JARM, FAPI 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d8" value="8. Compliance &amp; Privacy&#10;Event streaming / SIEM, GDPR tooling / residency, SOC2 / ISO 27001 / HIPAA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d9" value="9. Operability &amp; Scale&#10;OTel / Prometheus, multi-region HA / DR, quotas / metering / BYOK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d10" value="10. Extensibility &amp; DevEx&#10;Webhooks / SPIs, Terraform provider, multi-language SDKs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="580" width="300" height="70" as="geometry" /></mxCell>

