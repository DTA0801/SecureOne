<mxfile host="app.diagrams.net" type="device">
  <diagram id="config-inheritance" name="Configuration Inheritance">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p" value="Platform defaults&#10;(lockable; plan / feature availability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="t" value="Tenant settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="o" value="Organization settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="250" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="a" value="Application settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="350" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="eff" value="Effective configuration&#10;(resolved at runtime, cached in Redis)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="180" height="90" as="geometry" /></mxCell>

        <mxCell id="lock" value="🔒 A locked setting stops here —&#10;lower layers cannot override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="180" height="60" as="geometry" /></mxCell>

        <mxCell id="e1" value="override unless locked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="p" target="t"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="override unless locked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="t" target="o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="override unless locked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="o" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="a" target="eff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="lock" target="t"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
