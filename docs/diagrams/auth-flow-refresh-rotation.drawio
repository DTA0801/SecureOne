<mxfile host="app.diagrams.net" type="device">
  <diagram id="refresh-rotation" name="Refresh Token Rotation">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h_app" value="App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_auth" value="auth-server (SAS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="140" height="40" as="geometry" /></mxCell>

        <mxCell id="ll_app" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="60" as="sourcePoint" /><mxPoint x="150" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll_auth" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="60" as="sourcePoint" /><mxPoint x="550" y="470" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m1" value="1. /oauth2/token (grant_type=refresh_token)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="100" as="sourcePoint" /><mxPoint x="550" y="100" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. validate token + check family for reuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="200" height="40" as="geometry" /></mxCell>

        <mxCell id="alt" value="alt&#160;&#160;[reuse detected]&#160;/&#160;[valid]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=120;fillColor=none;strokeColor=#9673a6;fontStyle=2;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="510" height="230" as="geometry" /></mxCell>

        <mxCell id="m3" value="3a. REVOKE entire token family" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="250" as="sourcePoint" /><mxPoint x="150" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3b" value="3b. error: invalid_grant" style="html=1;endArrow=open;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="290" as="sourcePoint" /><mxPoint x="150" y="290" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="div" style="endArrow=none;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="320" as="sourcePoint" /><mxPoint x="630" y="320" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m4" value="4. rotate: issue NEW access + refresh token" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;fontColor=#82b366;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="370" as="sourcePoint" /><mxPoint x="150" y="370" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
